rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Players can read/write only their own profile and progress
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
    }
    match /players/{uid}/progress/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Username registry: anyone logged in can read (for uniqueness check), only owner can write
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
    // Player ID registry: same as usernames
    match /playerIds/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
    // Kółko i Krzyżyk - online games
    match /games/{gameId} {
      allow read: if request.auth != null &&
        (resource.data.creatorUid == request.auth.uid ||
         resource.data.opponentUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.creatorUid == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.creatorUid == request.auth.uid ||
         resource.data.opponentUid == request.auth.uid);
    }
    // Invitations subcollection
    match /invitations/{inviteeUid}/pending/{gameId} {
      allow read, delete: if request.auth != null && request.auth.uid == inviteeUid;
      allow create: if request.auth != null;
    }
    // Ranking
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Statki — online games
    match /battleshipGames/{gameId} {
      allow read: if request.auth != null &&
        (resource.data.creatorUid == request.auth.uid ||
         resource.data.opponentUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.creatorUid == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.creatorUid == request.auth.uid ||
         resource.data.opponentUid == request.auth.uid);
    }
    // Private grids — only owner can read
    match /battleshipGames/{gameId}/grids/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Statki ranking
    match /statkiRanking/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
